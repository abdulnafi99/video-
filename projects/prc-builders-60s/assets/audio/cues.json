    "end": 47.66,
    "text": "Komitmen terhadap penyiapan."
  },
  {
    "id": "t1",
    "start": 47.78,
    "end": 51,
    "text": "Merancang dengan tujuan. Membina dengan ketepatan."
  },
  {
    "id": "s6",
