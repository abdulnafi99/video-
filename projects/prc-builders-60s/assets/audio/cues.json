[
  {
    "id": "s1",
    "start": 0.9,
    "end": 5.73,
    "text": "Pi ar si Bilders. Membina kediaman, mencipta nilai yang berkekalan."
  },
  {
    "id": "s2",
    "start": 6.5,
    "end": 14.89,
    "text": "Kami rakan pembinaan kediaman anda, menggabungkan perancangan, reka bentuk dan pembinaan, dalam satu proses yang tersusun."
  },
  {
    "id": "s3a",
    "start": 15.4,
    "end": 24.77,
    "text": "Daripada reka bentuk dan bina, pembinaan rumah baharu, pengubahsuaian dan tambahan, kerja dalaman, hinggalah perundingan dan pengurusan projek."
  },
  {
    "id": "s3b",
    "start": 26.4,
    "end": 28.48,
    "text": "Penyelesaian kediaman yang lengkap."
  },
  {
    "id": "s4",
    "start": 29.3,
    "end": 31.9,
    "text": "Setiap projek melalui enam langkah yang jelas."
  },
  {
    "id": "p1",
    "start": 32.4,
    "end": 33,
    "text": "Memahami."
  },
  {
    "id": "p2",
    "start": 33.65,
    "end": 34.34,
    "text": "Merancang."
  },
  {
    "id": "p3",
    "start": 34.9,
    "end": 35.61,
    "text": "Mereka bentuk."
  },
  {
    "id": "p4",
    "start": 36.15,
    "end": 36.69,
    "text": "Membina."
  },
  {
    "id": "p5",
    "start": 37.4,
    "end": 37.81,
    "text": "Menyemak."
  },
  {
    "id": "p6",
    "start": 38.65,
    "end": 39.7,
    "text": "Dan menyerahkan."
  },
  {
    "id": "k1",
    "start": 40.3,
    "end": 42.1,
    "text": "Pengurusan projek yang profesional."
  },
  {
    "id": "k2",
    "start": 42.22,
    "end": 43.78,
    "text": "Tumpuan pada kualiti kerja."
  },
  {
    "id": "k3",
    "start": 43.9,
    "end": 45.9,
    "text": "Pendekatan berpaksikan pelanggan."
  },
  {
    "id": "k4",
